+/**
+ * Whether the running installation is a single-file executable.
+ *
+ * Such an executable mounts its package tree from a virtual snapshot and reports the deployed
+ * manifests, which keep the `workspace:` protocols they were copied with. There is no checkout
+ * behind them, so the source-installation branch below would reject a perfectly valid install.
+ * `process.pkg` is set by the executable runtime itself, so it also covers layouts where the
+ * anchor path is rewritten before it reaches this module.
+ * @param anchor - Real path of the running DSH package manifest.
+ * @returns true when this process runs from a single-file executable.
+ */
+function isPackagedInstallation(anchor: string): boolean {
+  const packaged = (process as { readonly pkg?: unknown }).pkg !== undefined
+  return packaged || /[\\/]snapshot[\\/]/i.test(anchor)
+}
