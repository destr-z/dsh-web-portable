+/**
+ * Whether a worker failure means this executable cannot load the verifier isolate at all.
+ *
+ * Single-file executables mount their package tree from a virtual snapshot, where the worker
+ * entry is not a real file the worker loader can open. The verification itself is identical
+ * in-process; only the fresh-isolate hardening is lost, so falling back is safe and still
+ * reports the same failures.
+ * @param error - the rejection from spawning or running the isolate.
+ * @returns true when the isolate could not be loaded, so verification should run in-process.
+ */
+function isIsolateUnavailable(error: unknown): boolean {
+  const message = error instanceof Error ? `${error.message}\n${error.stack ?? ''}` : String(error)
+  return /Cannot find module|ERR_MODULE_NOT_FOUND|ERR_UNKNOWN_FILE_EXTENSION|ERR_PACKAGE_PATH_NOT_EXPORTED/i
+    .test(message)
